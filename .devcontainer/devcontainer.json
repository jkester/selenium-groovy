{
  "name": "Java 17 + Maven",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "redhat.java",
        "vscjava.vscode-maven"
      ]
    }
  },

  "postCreateCommand": "mvn -v"
}
